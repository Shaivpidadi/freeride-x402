#!/bin/sh
# freeride — the single command for the FreeRide agent and gateway.
#
# One product, one front door. The agent binary (a fork of
# vercel-labs/fx) talks to the local FreeRide gateway on
# 127.0.0.1:11343, and this launcher keeps that daemon up.
#
#   freeride                     interactive agent session
#   freeride ask <prompt>         one noninteractive request
#   freeride start|stop|restart   manage the gateway daemon
#   freeride doctor              daemon + agent + wallet report
#   freeride wallet …            Hedera x402 cash lane
#   freeride serve|init|keys …   gateway commands (forwarded)
#   freeride gateway <cmd> …     any other gateway subcommand
#   freeride <anything else>     forwarded to the agent binary,
#                                auto-starting the daemon first
#
# The gateway CLI is installed as `freeride-gateway`, NOT `freeride`:
# this script owns that name, so forwarding to `freeride` would make it
# re-enter itself and fork-bomb on the ensure_daemon path.
#
# `freeride stop` sticks: it writes a marker and later invocations
# refuse to sneak the daemon back on. start / restart clear it.

set -eu

# Daemon state lives beside the gateway's own files; one product, one dir.
RIDEX_HOME="${RIDEX_HOME:-${FREERIDE_HOME:-$HOME/.freeride}}"
STOP_MARKER="$RIDEX_HOME/daemon.stopped"
PID_FILE="$RIDEX_HOME/daemon.pid"
DAEMON_LOG="$RIDEX_HOME/daemon.log"
GATEWAY_URL="${RIDEX_GATEWAY_URL:-http://127.0.0.1:11343}"
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
if [ -z "${RIDEX_AGENT_BIN:-}" ]; then
    for _cand in "$SCRIPT_DIR/freeride-agent" "$SCRIPT_DIR/../zig-out/bin/freeride-agent" "$SCRIPT_DIR/fx"; do
        if [ -x "$_cand" ]; then RIDEX_AGENT_BIN="$_cand"; break; fi
    done
fi
AGENT_BIN="${RIDEX_AGENT_BIN:-$SCRIPT_DIR/freeride-agent}"

# How the gateway is invoked. `freeride-gateway` is the gateway's own
# console script; this launcher owns the bare `freeride` name, so calling
# that here would recurse. Overridable for source checkouts:
#   FREERIDE_GATEWAY_CMD="python -m freeride" freeride ask ...
FREERIDE_CMD="${FREERIDE_GATEWAY_CMD:-${RIDEX_FREERIDE_CMD:-freeride-gateway}}"

healthy() {
    curl -sf -m 2 -o /dev/null "$GATEWAY_URL/health" 2>/dev/null
}

# During graceful shutdown the daemon stops answering /health before it
# releases the LISTEN socket, so port drains must probe the socket itself.
GATEWAY_HOSTPORT="${GATEWAY_URL#*://}"
GATEWAY_HOST="${GATEWAY_HOSTPORT%%:*}"
GATEWAY_PORT="${GATEWAY_HOSTPORT##*:}"

port_bound() {
    nc -z -G 1 -w 1 "$GATEWAY_HOST" "$GATEWAY_PORT" >/dev/null 2>&1
}

wait_port_free() {
    _deadline=$(( $(date +%s) + ${1:-15} ))
    while [ "$(date +%s)" -lt "$_deadline" ]; do
        port_bound || return 0
        sleep 0.3
    done
    return 1
}

require_freeride() {
    if ! command -v "${FREERIDE_CMD%% *}" >/dev/null 2>&1; then
        echo "freeride: the FreeRide gateway is not installed (command '${FREERIDE_CMD%% *}' not found)." >&2
        echo "freeride: install it with: curl -sSL https://api.free-ride.xyz/install.sh | sh" >&2
        exit 1
    fi
}

# ── supervision ─────────────────────────────────────────────────────
# The daemon should survive crashes, not just restart on the next
# freeride command. macOS gets a launchd LaunchAgent (KeepAlive on
# abnormal exit), Linux a systemd user unit (Restart=on-failure);
# anything else falls back to a detached nohup process. Set
# RIDEX_NO_SUPERVISOR=1 to force the nohup path.
LAUNCHD_LABEL="xyz.free-ride.gateway"
LAUNCHD_PLIST="$HOME/Library/LaunchAgents/$LAUNCHD_LABEL.plist"
SYSTEMD_UNIT="$HOME/.config/systemd/user/freeride.service"

supervisor_kind() {
    if [ "${RIDEX_NO_SUPERVISOR:-0}" = "1" ]; then echo none; return; fi
    if command -v launchctl >/dev/null 2>&1 && [ "$(uname -s)" = "Darwin" ]; then
        echo launchd; return
    fi
    if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
        echo systemd; return
    fi
    echo none
}

# Render FREERIDE_CMD + "serve" as plist <string> argv entries. Words
# must not contain spaces (env VAR=... wrappers and plain paths are
# fine). launchd requires an absolute argv[0], so the first word is
# resolved through PATH at render time.
plist_program_arguments() {
    _first=1
    for word in $FREERIDE_CMD serve; do
        if [ "$_first" = "1" ]; then
            _first=0
            _resolved="$(command -v "$word" 2>/dev/null || echo "$word")"
            printf '        <string>%s</string>\n' "$_resolved"
        else
            printf '        <string>%s</string>\n' "$word"
        fi
    done
}

write_launchd_plist() {
    mkdir -p "$(dirname "$LAUNCHD_PLIST")" "$RIDEX_HOME"
    cat > "$LAUNCHD_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LAUNCHD_LABEL</string>
    <key>ProgramArguments</key>
    <array>
$(plist_program_arguments)    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>$PATH</string>
        <!-- launchd does not inherit the invoking shell's HOME; without
             it the daemon would read root-session defaults instead of
             this user's ~/.freeride. -->
        <key>HOME</key><string>$HOME</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key><false/>
    </dict>
    <key>StandardOutPath</key><string>$DAEMON_LOG</string>
    <key>StandardErrorPath</key><string>$DAEMON_LOG</string>
</dict>
</plist>
PLIST
}

write_systemd_unit() {
    mkdir -p "$(dirname "$SYSTEMD_UNIT")" "$RIDEX_HOME"
    cat > "$SYSTEMD_UNIT" <<UNIT
[Unit]
Description=FreeRide gateway (freeride model backend)

[Service]
ExecStart=$(command -v "${FREERIDE_CMD%% *}" >/dev/null 2>&1 && echo "$FREERIDE_CMD serve" || echo "freeride-gateway serve")
Restart=on-failure
RestartSec=2
StandardOutput=append:$DAEMON_LOG
StandardError=append:$DAEMON_LOG

[Install]
WantedBy=default.target
UNIT
}

launchd_wait_unregistered() {
    # bootout is asynchronous; bootstrapping again while the old
    # registration is mid-teardown fails (and previously dropped us to
    # the unsupervised fallback while the dying instance still held the
    # port). Poll until the label is gone, up to ~5s.
    _deadline=$(( $(date +%s) + 5 ))
    while [ "$(date +%s)" -lt "$_deadline" ]; do
        launchctl print "gui/$(id -u)/$LAUNCHD_LABEL" >/dev/null 2>&1 || return 0
        sleep 0.3
    done
    return 1
}

supervisor_stop() {
    case "$(supervisor_kind)" in
        launchd)
            launchctl bootout "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null || true
            launchd_wait_unregistered || true
            ;;
        systemd)
            systemctl --user stop freeride.service 2>/dev/null || true
            systemctl --user disable freeride.service 2>/dev/null || true
            ;;
    esac
}

spawn_daemon() {
    mkdir -p "$RIDEX_HOME"
    require_freeride
    case "$(supervisor_kind)" in
        launchd)
            supervisor_stop  # a stale registration blocks bootstrap
            write_launchd_plist
            launchctl bootstrap "gui/$(id -u)" "$LAUNCHD_PLIST" 2>/dev/null || {
                echo "freeride: launchctl bootstrap failed; falling back to a plain background process." >&2
                # shellcheck disable=SC2086
                nohup $FREERIDE_CMD serve >>"$DAEMON_LOG" 2>&1 &
                echo $! > "$PID_FILE"
                return
            }
            rm -f "$PID_FILE"  # launchd owns the process now
            ;;
        systemd)
            write_systemd_unit
            systemctl --user daemon-reload
            systemctl --user enable --now freeride.service 2>/dev/null || {
                echo "freeride: systemd user unit failed; falling back to a plain background process." >&2
                # shellcheck disable=SC2086
                nohup $FREERIDE_CMD serve >>"$DAEMON_LOG" 2>&1 &
                echo $! > "$PID_FILE"
                return
            }
            rm -f "$PID_FILE"
            ;;
        none)
            # shellcheck disable=SC2086 — FREERIDE_CMD may carry args ("python -m freeride")
            nohup $FREERIDE_CMD serve >>"$DAEMON_LOG" 2>&1 &
            echo $! > "$PID_FILE"
            ;;
    esac
}

wait_healthy() {
    _deadline=$(( $(date +%s) + ${1:-20} ))
    while [ "$(date +%s)" -lt "$_deadline" ]; do
        healthy && return 0
        sleep 0.5
    done
    return 1
}

# The gateway is a brick without provider keys. /health lists the
# providers whose keys it loaded; an empty list means `freeride init`
# has never run — prompt for keys right here (local machine, never
# through any chat), then hot-reload the daemon.
ensure_keys() {
    _field=$(curl -sf -m 2 "$GATEWAY_URL/health" 2>/dev/null | grep -o '"keyed_providers":[[:space:]]*\[[^]]*\]' || true)
    [ -z "$_field" ] && return 0  # pre-0.4.0a22 gateway without the field: don't guess
    case "${_field#*\[}" in
        *'"'*) return 0 ;;  # at least one provider holds a usable key
    esac
    echo "freeride: no provider keys are configured yet. Running key setup (keys stay on this machine)." >&2
    $FREERIDE_CMD init || {
        echo "freeride: key setup did not complete; get a free key at openrouter.ai/keys and re-run." >&2
        exit 1
    }
    $FREERIDE_CMD reload >/dev/null 2>&1 || true
}

# Hedera cash lane: when x402 is enabled without a payer, or the gateway
# already answered 402, offer one interactive wallet setup (same ~/.freeride/.env).
WALLET_PROMPT_MARKER="$RIDEX_HOME/wallet.setup-prompted"

ensure_wallet() {
    command -v "${FREERIDE_CMD%% *}" >/dev/null 2>&1 || return 0
    # Only prompt once per machine unless marker cleared.
    [ -e "$WALLET_PROMPT_MARKER" ] && return 0

    _needs=0
    # freeride wallet status is cheap and never prints secrets.
    _wstat=$($FREERIDE_CMD wallet status 2>/dev/null || true)
    echo "$_wstat" | grep -q 'enabled     : yes' || return 0
    echo "$_wstat" | grep -q 'auto-pay    : yes' && return 0
    # enabled but no auto-pay → missing payer or pay_to
    _needs=1

    if [ "$_needs" = "1" ]; then
        mkdir -p "$RIDEX_HOME"
        touch "$WALLET_PROMPT_MARKER"
        if [ -t 0 ]; then
            printf 'freeride: Free models need a Hedera cash lane when free dies. Run setup? [Y/n] ' >&2
            read -r _ans || _ans=n
            case "$_ans" in
                ""|y|Y|yes|YES)
                    $FREERIDE_CMD wallet setup || {
                        echo "freeride: wallet setup did not complete; run: freeride wallet setup" >&2
                        return 0
                    }
                    $FREERIDE_CMD reload >/dev/null 2>&1 || true
                    ;;
                *)
                    echo "freeride: skipped. Later: freeride wallet setup" >&2
                    ;;
            esac
        else
            echo "freeride: x402 enabled without payer — run: freeride wallet setup" >&2
        fi
    fi
}

# The agent's operational knowledge of FreeRide ships as an fx skill:
# when a request fails, the model consults it to self-diagnose (daemon
# state, keys, cooldowns, failover taxonomy). Installed/refreshed into
# the user-scope skills dir on every launch so upgrades propagate.
SKILLS_HOME="${RIDEX_SKILLS_HOME:-$HOME/.fx/skills}"

ensure_skill() {
    for _src in "$SCRIPT_DIR/../assets/skills/freeride/SKILL.md" \
                "$SCRIPT_DIR/skills/freeride/SKILL.md" \
                "$HOME/.local/share/freeride/skills/freeride/SKILL.md"; do
        if [ -f "$_src" ]; then
            _dst="$SKILLS_HOME/freeride/SKILL.md"
            if ! cmp -s "$_src" "$_dst" 2>/dev/null; then
                mkdir -p "$SKILLS_HOME/freeride"
                cp "$_src" "$_dst"
            fi
            return 0
        fi
    done
}

ensure_daemon() {
    ensure_skill
    if healthy; then
        ensure_keys
        ensure_wallet
        return 0
    fi
    if [ -e "$STOP_MARKER" ]; then
        echo "freeride: the FreeRide daemon is stopped (you ran 'freeride stop')." >&2
        echo "freeride: run 'freeride start' to bring it back." >&2
        exit 1
    fi
    echo "freeride: starting the FreeRide daemon..." >&2
    spawn_daemon
    if ! wait_healthy 30; then
        echo "freeride: the FreeRide daemon did not become healthy on $GATEWAY_URL." >&2
        echo "freeride: check $DAEMON_LOG, or run 'freeride doctor'." >&2
        exit 1
    fi
    ensure_keys
    ensure_wallet
}

stop_daemon() {
    mkdir -p "$RIDEX_HOME"
    touch "$STOP_MARKER"
    supervisor_stop
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        kill "$(cat "$PID_FILE")" 2>/dev/null || true
    elif port_bound; then
        # Daemon may have been spawned by an earlier install or manually.
        pkill -f "freeride[ .]" 2>/dev/null || pkill -f "freeride.cli.main serve" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    # Wait for the socket to actually close so an immediately-following
    # freeride command can't race a dying-but-still-bound daemon.
    wait_port_free 10 || true
    echo "freeride: FreeRide daemon stopped. It stays stopped until 'freeride start'."
}

doctor() {
    echo "freeride doctor"
    echo "  agent binary : $AGENT_BIN $([ -x "$AGENT_BIN" ] && echo '(ok)' || echo '(MISSING)')"
    echo "  gateway url  : $GATEWAY_URL"
    if healthy; then
        echo "  daemon       : healthy (supervision: $(supervisor_kind))"
    elif [ -e "$STOP_MARKER" ]; then
        echo "  daemon       : stopped by user ('freeride start' to resume)"
    else
        echo "  daemon       : NOT RUNNING ('freeride start', or any freeride command auto-starts it)"
    fi
    if command -v "${FREERIDE_CMD%% *}" >/dev/null 2>&1; then
        # Key/provider status lives with the gateway.
        $FREERIDE_CMD doctor 2>/dev/null || true
        echo
        $FREERIDE_CMD wallet status 2>/dev/null || true
    else
        echo "  freeride     : not installed — curl -sSL https://api.free-ride.xyz/install.sh | sh"
    fi
}

case "${1:-}" in
    start)
        rm -f "$STOP_MARKER"
        if healthy; then echo "freeride: FreeRide daemon already running."; exit 0; fi
        spawn_daemon
        wait_healthy 30 && echo "freeride: FreeRide daemon started." || {
            echo "freeride: daemon failed to start; see $DAEMON_LOG" >&2; exit 1; }
        ;;
    stop)
        stop_daemon
        ;;
    restart)
        rm -f "$STOP_MARKER"
        supervisor_stop
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            kill "$(cat "$PID_FILE")" 2>/dev/null || true
        fi
        rm -f "$PID_FILE"
        # Wait for the old daemon to release the port before spawning,
        # or the new one dies with "already in use".
        wait_port_free 15 || {
            echo "freeride: something else is holding $GATEWAY_HOST:$GATEWAY_PORT; not spawning." >&2
            exit 1
        }
        spawn_daemon
        wait_healthy 30 && echo "freeride: FreeRide daemon restarted." || {
            echo "freeride: daemon failed to restart; see $DAEMON_LOG" >&2; exit 1; }
        ;;
    doctor)
        doctor
        ;;
    wallet)
        require_freeride
        shift
        if [ "${1:-}" = "" ]; then
            exec $FREERIDE_CMD wallet status
        fi
        # shellcheck disable=SC2086
        exec $FREERIDE_CMD wallet "$@"
        ;;
    # Gateway-owned verbs. `freeride serve` etc. must reach the gateway,
    # not the agent, so standalone gateway users keep their muscle memory
    # now that both halves answer to one name. Verbs the agent also owns
    # (status, models, upgrade) stay with the agent; reach the gateway's
    # versions through `freeride gateway <cmd>`.
    serve|init|keys|providers|telemetry|reload|bind|audit-models|bench|watch|run)
        require_freeride
        # shellcheck disable=SC2086
        exec $FREERIDE_CMD "$@"
        ;;
    gateway)
        require_freeride
        shift
        if [ "${1:-}" = "" ]; then
            echo "freeride: usage: freeride gateway <gateway-subcommand>" >&2
            exec $FREERIDE_CMD --help
        fi
        # shellcheck disable=SC2086
        exec $FREERIDE_CMD "$@"
        ;;
    *)
        ensure_daemon
        # A non-default gateway URL must reach the agent binary too; its
        # compiled default is 127.0.0.1:11343 and it honors loopback
        # FX_GATEWAY_* overrides.
        if [ "$GATEWAY_URL" != "http://127.0.0.1:11343" ]; then
            FX_GATEWAY_CHAT_URL="$GATEWAY_URL/v3/ai/language-model"
            FX_GATEWAY_BASE_URL="$GATEWAY_URL"
            export FX_GATEWAY_CHAT_URL FX_GATEWAY_BASE_URL
        fi
        exec "$AGENT_BIN" "$@"
        ;;
esac
